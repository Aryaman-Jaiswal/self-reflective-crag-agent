# LLM API Keys (Optional - The system falls back automatically to the built-in Smart Rule-Based Engine if omitted)
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# LLM Provider Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.7-flash
# Alternatives: gemini-3.5-flash-lite, gpt-4o-mini, gpt-4o, claude-3-5-sonnet

# Dense Embedding & Reranker Configuration
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Vector Store
QDRANT_COLLECTION=crag_knowledge_base
QDRANT_LOCATION=:memory:
